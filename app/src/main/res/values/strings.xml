    <string name="unit_minute_short">m</string>
    <string name="trip_detail_delete_title">Delete this trip?</string>
    <string name="trip_detail_delete_body">This cannot be undone.</string>
    <string name="trip_detail_share_chooser">Share trip</string>
    <!--
        Trip share text. Translators: keep all 8 args, you may rearrange them.
        %1$s = date (e.g. "Apr 25"), %2$s = distance number, %3$s = distance unit (km/mi),
        %4$s = formatted duration (e.g. "1h 23m"),
        %5$s = top speed number, %6$s = speed unit (km/h/mph),
        %7$s = avg speed number, %8$s = speed unit
    -->
    <string name="trip_detail_share_template">%1$s drive · %2$s %3$s · %4$s · top %5$s %6$s · avg %7$s %8$s</string>

    <!-- ===== Date / time format patterns =====
         These ARE localized. Keep ICU-style symbols (M, d, E, H, m, y) — only their order/literal text changes per language. -->
    <string name="format_date_month_day">MMM d</string>
    <string name="format_date_month_day_weekday">MMM d (E)</string>
    <string name="format_date_month_day_short">M/d (E)</string>
    <string name="format_date_year_month">MMMM yyyy</string>
    <string name="format_time_hm">HH:mm</string>
    <!-- %1$s = start, %2$s = end (e.g. "14:00 – 15:30") -->
    <string name="format_time_range">%1$s – %2$s</string>

    <!-- ===== Duration ===== -->
    <!-- %1$d = hours, %2$d = minutes (e.g. "1h 23m") -->
    <string name="duration_h_m">%1$dh %2$dm</string>
    <!-- %1$d = minutes (e.g. "45m") -->
    <string name="duration_m">%1$dm</string>
    <!-- Zero/no-data placeholder for duration. -->
    <string name="duration_zero">0m</string>

    <!-- ===== Weekday short labels (Sun..Sat). Used across heatmap, weekday chart, insights. ===== -->
    <string-array name="weekday_short_labels">
        <item>Sun</item>
        <item>Mon</item>
        <item>Tue</item>
        <item>Wed</item>
        <item>Thu</item>
        <item>Fri</item>
        <item>Sat</item>
    </string-array>
    <!--
        Weekday wrapped for use inside a sentence. Korean adds "요일" suffix; Japanese adds "曜日";
        most other languages just pass through. %1$s = short weekday from weekday_short_labels.
    -->
    <string name="weekday_with_suffix">%1$s</string>

    <!-- ===== Time-of-day buckets (used in insight sentence) ===== -->
    <string name="time_bucket_dawn">early morning</string>           <!-- 04:00–07:59 -->
    <string name="time_bucket_commute_morning">morning commute</string> <!-- 08:00–09:59 -->
    <string name="time_bucket_daytime">daytime</string>              <!-- 10:00–15:59 -->
    <string name="time_bucket_commute_evening">evening commute</string> <!-- 16:00–18:59 -->
    <string name="time_bucket_evening">evening</string>              <!-- 19:00–22:59 -->
    <string name="time_bucket_late_night">late night</string>        <!-- 23:00–03:59 -->

    <!-- ===== Driving insight sentences (full sentences, NOT concatenated). Reorder args freely. =====
         %1$s = bucket label (e.g. "morning commute"), %2$d = peak hour (0-23), %3$d = trip count -->
    <string name="insight_peak_bucket">You drive most often in the %1$s, around %2$d:00 (%3$d trips).</string>
    <!-- %1$s = weekday label (e.g. "Monday"), %2$d = avg speed value, %3$s = unit (km/h or mph) -->
    <string name="insight_fastest_weekday">Your fastest day is %1$s — averaging %2$d %3$s.</string>
    <!-- %1$d = absolute percent change (already abs+rounded). Two distinct keys instead of an inline word swap. -->
    <string name="insight_weekly_distance_up">You drove %1$d%% more than last week.</string>
    <string name="insight_weekly_distance_down">You drove %1$d%% less than last week.</string>
    <string name="insight_empty">More driving data unlocks personalized insights here.</string>

